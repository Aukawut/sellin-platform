# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าก่อนรันในเครื่อง
# ตอน deploy จริงให้ตั้งค่าเหล่านี้เป็น environment ของ container แทนการวางไฟล์ .env

APP_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://sellin:sellin@localhost:5432/sellin?sslmode=disable

# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -base64 48
JWT_SECRET=เปลี่ยนค่านี้ก่อนใช้งานจริง-อย่างน้อยสามสิบสองตัวอักษร
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:5173

# ลบข้อมูล fact ของชุดที่ถูกลบไปแล้วเกินกี่วัน (ตัว record และไฟล์ต้นฉบับยังเก็บไว้)
PURGE_AFTER_DAYS=90
