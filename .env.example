# ค่าที่ docker compose อ่านตอนสตาร์ท คัดลอกเป็น .env แล้วแก้ก่อนใช้งาน
# สร้างค่าลับใหม่ด้วย: openssl rand -base64 48
# ไฟล์ .env อยู่ใน .gitignore แล้ว ห้ามนำขึ้น repo ไม่ว่ากรณีใด

# --- บังคับตั้ง ระบบไม่ยอมสตาร์ทถ้าว่าง ---
# ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / ? #) ต้อง URL-encode เพราะค่านี้ถูกต่อเป็น DATABASE_URL
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านฐานข้อมูลก่อนใช้งานจริง
# ต้องยาวอย่างน้อย 32 ตัวอักษร เปลี่ยนค่านี้แล้วผู้ใช้ทุกคนจะถูกบังคับล็อกอินใหม่
JWT_SECRET=เปลี่ยนค่านี้ก่อนใช้งานจริง-ต้องยาวอย่างน้อยสามสิบสองตัวอักษร

# --- แอปพลิเคชัน ---
APP_ENV=production
LOG_LEVEL=info

# ตั้ง flag Secure ให้ cookie ของ refresh token — เบราว์เซอร์จะส่ง cookie กลับมาเฉพาะบน HTTPS
# ปล่อยว่าง = เปิดอัตโนมัติเมื่อ APP_ENV=production ซึ่งเป็นค่าที่ควรใช้
# ตั้ง false ก็ต่อเมื่อยังเปิดเว็บผ่าน http ธรรมดาอยู่ (เช่นเรียกด้วย IP:port)
# เมื่อเป็น false รหัสผ่านและ token จะเดินทางแบบไม่เข้ารหัส ใครดักกลางทางได้ก็อ่านได้ทั้งหมด
COOKIE_SECURE=false

# ใช้เฉพาะกรณีหน้าเว็บอยู่คนละ origin กับ API ถ้า nginx proxy /api ให้ ค่านี้ไม่ถูกใช้
CORS_ORIGINS=http://203.150.191.169:8081
MAX_UPLOAD_MB=25
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
PURGE_AFTER_DAYS=90

# --- พอร์ตที่เปิดออกมาจาก container ---
# ค่าเริ่มต้นผูกกับ 127.0.0.1 ให้ nginx บนเครื่องเดียวกันเรียกเท่านั้น
# ตั้งเป็น 0.0.0.0 ก็ต่อเมื่อมี firewall คุมอยู่จริง ๆ
# 7779 คือพอร์ตบนเครื่อง ที่ nginx (และ curl ตอนตรวจสอบ) เรียกเข้ามา
# ตั้ง API_BIND=0.0.0.0 ก็ต่อเมื่อต้องให้เครื่องอื่นเรียก API ตรงจริง ๆ และมี firewall คุมอยู่
API_BIND=127.0.0.1
API_PORT=7779
DB_BIND=127.0.0.1
DB_PORT=5433

# --- ฐานข้อมูล ---
# สองค่านี้มีผลตอน initdb ครั้งแรกเท่านั้น ถ้า volume ถูกสร้างแล้วการแก้ค่าจะทำให้ต่อไม่ติด
POSTGRES_USER=sellin
POSTGRES_DB=sellin

# --- ชื่อ image ใช้ตอนทำ registry หรือแยกเวอร์ชันเวลา rollback ---
IMAGE_NAME=sellin-api
IMAGE_TAG=local
